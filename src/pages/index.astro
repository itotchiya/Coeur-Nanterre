---
/**
 * Cœur Nanterre — Main Page
 * Programme immobilier à Nanterre
 */

import Layout from "../layouts/Layout.astro";

// Import all section components
import Header from "../components/sections/Header.astro";
import Hero from "../components/sections/Hero.astro";
import ProjectEssence from "../components/sections/ProjectEssence.astro";
import Location from "../components/sections/Location.astro";
import Connectivity from "../components/sections/Connectivity.astro";
import ApartmentSection from "../components/sections/ApartmentSection.astro";
import Prestations from "../components/sections/Prestations.astro";
import ProgramOverview from "../components/sections/ProgramOverview.astro";
import CreditSimulator from "../components/sections/CreditSimulator.astro";
import InvestorJeanbrun from "../components/sections/InvestorJeanbrun.astro";
import BrochureCta from "../components/sections/BrochureCta.astro";
import Footer from "../components/sections/Footer.astro";
---

<Layout title="Cœur Nanterre — Programme immobilier">
  <Header />
  <main id="main-content" data-page="home">
    <Hero />
    <ProjectEssence />
    <Location />
    <Connectivity />
    <ApartmentSection />
    <Prestations />
    <ProgramOverview />
    <CreditSimulator />
    <InvestorJeanbrun />
    <BrochureCta />
  </main>
  <Footer />
</Layout>
