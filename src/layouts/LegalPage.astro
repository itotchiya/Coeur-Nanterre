---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cœur Nanterre — Programme immobilier à Nanterre" } = Astro.props;
---

<Layout title={title} description={description}>
  <header class="legal-header">
    <div class="legal-header__container">
      <a href="/" class="legal-header__logo" aria-label="Retour à l'accueil">
        <img
          src="/Assets/logo-nanterre.svg"
          alt="Cœur Nanterre"
          width="180"
          height="50"
        />
      </a>
      <a href="/" class="legal-header__back">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Retour au site
      </a>
    </div>
  </header>

  <main class="legal-page">
    <div class="legal-page__wrapper">
      <article class="legal-page__content" id="legal-content">
        <slot />
      </article>

      <aside class="legal-page__toc" aria-label="Table des matières">
        <nav class="legal-page__toc-nav" id="toc-nav">
          <p class="legal-page__toc-title">Sommaire</p>
          <ul class="legal-page__toc-list" id="toc-list"></ul>
        </nav>
      </aside>
    </div>
  </main>

  <footer class="legal-footer">
    <p>© {new Date().getFullYear()} Cœur Nanterre — Tous droits réservés</p>
  </footer>

  <style>
    .legal-header {
      border-bottom: 1px solid var(--color-gray-200);
      background: var(--color-white);
    }
    .legal-header__container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .legal-header__logo img {
      height: 40px;
      width: auto;
      display: block;
    }
    .legal-header__back {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-family-base);
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--color-primary);
      text-decoration: none;
      transition: opacity 0.2s ease;
    }
    .legal-header__back:hover {
      opacity: 0.7;
    }

    .legal-page {
      background: var(--color-white);
      padding: 3rem 2rem 5rem;
    }
    .legal-page__wrapper {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    @media (min-width: 1024px) {
      .legal-page__wrapper {
        grid-template-columns: 1fr 260px;
        gap: 4rem;
      }
    }

    .legal-page__content {
      max-width: 680px;
    }
    .legal-page__content :global(h1) {
      font-family: var(--font-family-heading);
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--color-primary);
      text-transform: uppercase;
      margin-bottom: 2.5rem;
    }
    .legal-page__content :global(h2) {
      font-family: var(--font-family-heading);
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.3;
      color: var(--color-primary-dark);
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      scroll-margin-top: 100px;
    }
    .legal-page__content :global(h2:first-of-type) {
      margin-top: 0;
    }
    .legal-page__content :global(p) {
      font-family: var(--font-family-base);
      font-size: 1rem;
      line-height: 1.7;
      color: var(--color-gray-700);
      margin-bottom: 1rem;
    }
    .legal-page__content :global(ul) {
      list-style: disc;
      padding-left: 1.5rem;
      margin-bottom: 1rem;
    }
    .legal-page__content :global(ul li) {
      font-family: var(--font-family-base);
      font-size: 1rem;
      line-height: 1.7;
      color: var(--color-gray-700);
      margin-bottom: 0.5rem;
    }
    .legal-page__content :global(a) {
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .legal-page__content :global(a:hover) {
      color: var(--color-primary-dark);
    }
    .legal-page__content :global(strong) {
      font-weight: 600;
      color: var(--color-gray-800);
    }

    .legal-page__toc {
      display: none;
    }
    @media (min-width: 1024px) {
      .legal-page__toc {
        display: block;
      }
    }
    .legal-page__toc-nav {
      position: sticky;
      top: 120px;
      padding: 1.5rem;
      background: var(--color-gray-50);
      border-radius: 8px;
      border: 1px solid var(--color-gray-200);
    }
    .legal-page__toc-title {
      font-family: var(--font-family-base);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-gray-400);
      margin: 0 0 1rem 0;
    }
    .legal-page__toc-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }
    .legal-page__toc-list :global(a) {
      display: block;
      font-family: var(--font-family-base);
      font-size: 0.875rem;
      line-height: 1.4;
      color: var(--color-gray-600);
      text-decoration: none;
      padding: 0.375rem 0.5rem;
      border-radius: 4px;
      transition: background 0.2s ease, color 0.2s ease;
    }
    .legal-page__toc-list :global(a:hover) {
      background: var(--color-gray-200);
      color: var(--color-primary);
    }
    .legal-page__toc-list :global(a.is-active) {
      background: var(--color-primary);
      color: var(--color-white);
      font-weight: 500;
    }

    .legal-footer {
      border-top: 1px solid var(--color-gray-200);
      background: var(--color-gray-50);
      padding: 2rem;
      text-align: center;
    }
    .legal-footer p {
      font-family: var(--font-family-base);
      font-size: 0.875rem;
      color: var(--color-gray-400);
      margin: 0;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const article = document.getElementById("legal-content");
      const tocList = document.getElementById("toc-list");
      if (!article || !tocList) return;

      const headings = article.querySelectorAll("h2");
      if (headings.length === 0) {
        const tocNav = document.getElementById("toc-nav");
        if (tocNav) tocNav.style.display = "none";
        return;
      }

      headings.forEach((heading, i) => {
        const id = heading.id || `section-${i}`;
        if (!heading.id) heading.id = id;

        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${id}`;
        a.textContent = heading.textContent || "";
        a.addEventListener("click", (e) => {
          e.preventDefault();
          document.getElementById(id)?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        li.appendChild(a);
        tocList.appendChild(li);
      });

      const links = tocList.querySelectorAll("a");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              links.forEach((l) => l.classList.remove("is-active"));
              const active = tocList.querySelector(`a[href="#${entry.target.id}"]`);
              active?.classList.add("is-active");
            }
          });
        },
        { rootMargin: "-15% 0px -70% 0px" }
      );

      headings.forEach((h) => observer.observe(h));
    });
  </script>
</Layout>
