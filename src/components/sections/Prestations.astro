---
/**
 * Prestations Section
 * Finitions & équipements — extrait de la plaquette
 */
import AnimatedVerticalLine from "../ui/AnimatedVerticalLine.astro";
import { CircleCheck } from "lucide-astro";

const prestations = [
  "Volet roulant électrique",
  "Carrelage 60×60 — pièces de jour",
  "Parquet contrecollé — chambres",
  "Carrelage 45×45 — salle de bain & WC",
  "Faïence toute hauteur — douche & baignoire",
  "Hall d'entrée sécurisé décoré",
  "Stationnement en sous-sol",
  "Local vélo sécurisé",
  "Robinetterie Hansgrohe ou équivalent",
  "Système de vidéophone",
];
---

<section
  class="prestations"
  data-section="prestations"
  id="prestations"
  aria-labelledby="prestations-title"
>
  <div class="prestations__container">
    <header class="prestations__header" data-animate="prestations-header">
      <div class="prestations__title-group">
        <AnimatedVerticalLine />
        <div>
          <span class="prestations__overline">Prestations</span>
          <h2 id="prestations-title" class="prestations__title type-h2">
            Une palette pensée<br />pour la durée
          </h2>
        </div>
      </div>
      <p class="prestations__intro type-body">
        Des matériaux et équipements soignés, pensés pour votre confort au
        quotidien et pour traverser les années avec élégance.
      </p>
    </header>

    <div class="prestations__grid" data-animate="prestations-grid">
      {
        prestations.map((item) => (
          <div class="prestations__item">
            <CircleCheck
              size={28}
              stroke-width={2}
              class="prestations__icon"
              aria-hidden="true"
            />
            <span class="prestations__text">{item}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @import "../../styles/prestations.css";
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector(".prestations");
    if (!section) return;

    const ease = "power2.out";

    gsap.fromTo(
      '[data-animate="prestations-header"]',
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease,
        scrollTrigger: {
          trigger: '[data-animate="prestations-header"]',
          start: "top 80%",
          once: true,
        },
      }
    );

    const items = section.querySelectorAll(".prestations__item");
    items.forEach((item, i) => {
      gsap.fromTo(
        item,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease,
          delay: i * 0.06,
          scrollTrigger: {
            trigger: '[data-animate="prestations-grid"]',
            start: "top 80%",
            once: true,
          },
        }
      );
    });
  });
</script>
