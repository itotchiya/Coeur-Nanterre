---
/**
 * Lifestyle Section
 * Une expérience de vie à imaginer
 * Immersive editorial gallery with spec anchors
 */
import InteractiveImageCard from "../ui/InteractiveImageCard.astro";
import AnimatedOrbs from "../ui/AnimatedOrbs.astro";
import Button from "../ui/Button.astro";

// Import Lifestyle Images
import arch04 from "../../assets/arch04.avif";
import arch15 from "../../assets/arch15.avif";
import arch32 from "../../assets/arch32.avif";
import arch24 from "../../assets/arch24.avif";
import arch26 from "../../assets/arch26.avif";
import arch06 from "../../assets/arch06.avif";
import arch12 from "../../assets/arch12.avif";
import arch01 from "../../assets/arch01.avif";
---

<section
  class="lifestyle"
  data-section="lifestyle"
  id="lifestyle"
  aria-labelledby="lifestyle-title"
>
  <div class="lifestyle__container">
    <!-- 1. INTRODUCTION -->
    <header class="lifestyle__header" data-animate="lifestyle-header">
      <h2 id="lifestyle-title" class="lifestyle__title type-h2">
        Un cadre de vie pensé pour le quotidien
      </h2>
      <p class="lifestyle__subtitle type-body-lg">
        Des espaces de vie confortables, lumineux et fonctionnels adaptés aux
        usages contemporains.
      </p>
    </header>

    <!-- 3. IMMERSIVE IMAGE GALLERY — 2×2 Grid -->
    <div class="lifestyle__gallery">
      <!-- 2. LIFESTYLE MARQUEE (Infinite Loop) - Moved inside gallery -->
      <div class="lifestyle__marquee" data-animate="lifestyle-marquee">
        <AnimatedOrbs />

        <div class="lifestyle__marquee-inner">
          {
            /* Render list twice for seamless loop */
            [1, 3].map(() => (
              <ul class="lifestyle__marquee-list">
                <li>Terrasses privatives</li>
                <li class="dot" />
                <li>Jardins au rez-de-chaussée</li>
                <li class="dot" />
                <li>Séjours baignés de lumière</li>
                <li class="dot" />
                <li>Volets roulants</li>
                <li class="dot" />
                <li>Parking sécurisé</li>
                <li class="dot" />
                <li>Ascenseur 630 kg</li>
                <li class="dot" />
                <li>Local vélos</li>
                <li class="dot" />
                <li>Dressings intégrés</li>
                <li class="dot" />
                <li>Portes-fenêtres</li>
                <li class="dot" />
              </ul>
            ))
          }
        </div>
      </div>
      <!-- Row 1 -->
      <div class="lifestyle__row" data-animate="lifestyle-row-1">
        <InteractiveImageCard
          title="Séjour / Cuisine Ouvert"
          description="Chaque logement est articulé autour d'un séjour-cuisine généreux, traversant ou en double exposition, avec accès direct sur terrasse."
          placeholderText="Séjour – rendu à venir"
          src={arch04.src}
          specs={[
            { icon: "◎", text: "Open-plan lumineux" },
            { icon: "◎", text: "Portes-fenêtres" },
            { icon: "◎", text: "Volets roulants" },
          ]}
        />
        <InteractiveImageCard
          title="Terrasses Privatives"
          description="Du T2 au T4+, chaque logement dispose d'une terrasse propre. La plus grande atteint 67,28 m² au R+2 — un véritable prolongement extérieur."
          placeholderText="Terrasse – rendu à venir"
          src={arch15.src}
          specs={[
            { icon: "◎", text: "Jusqu'à 67 m²" },
            { icon: "◎", text: "Orientation sud / ouest" },
            { icon: "◎", text: "Garde-corps" },
          ]}
        />
      </div>

      <!-- Row 2 -->
      <div class="lifestyle__row" data-animate="lifestyle-row-2">
        <InteractiveImageCard
          title="Jardins Privatifs au RDC"
          description="Les logements du rez-de-chaussée bénéficient de jardins privatifs clos directement accessibles depuis le séjour."
          placeholderText="Jardin – rendu à venir"
          src={arch32.src}
          specs={[
            { icon: "◎", text: "A1 : Jardin 7,10 m²" },
            { icon: "◎", text: "A3 : Jardin 3,12 m²" },
            { icon: "◎", text: "Accès direct séjour" },
          ]}
        />
        <InteractiveImageCard
          title="Parking Sécurisé Sous-Sol"
          description="Un parking en sous-sol avec 8 places individuelles, accessible par rampe dédiée. Zone deux-roues motorisés séparée."
          placeholderText="Parking – rendu à venir"
          src={arch24.src}
          specs={[
            { icon: "◎", text: "8 places sous-sol" },
            { icon: "◎", text: "Accès rampe sécurisé" },
            { icon: "◎", text: "Zone motos" },
          ]}
        />
      </div>

      <!-- Row 3 -->
      <div class="lifestyle__row" data-animate="lifestyle-row-3">
        <InteractiveImageCard
          title="Chambres & Dressings"
          description="Les T4 et T5 proposent jusqu'à 4 chambres et des dressings intégrés. Les chambres bénéficient toutes d'une fenêtre sur l'extérieur."
          placeholderText="Chambre – rendu à venir"
          src={arch26.src}
          specs={[
            { icon: "◎", text: "Jusqu'à 4 chambres" },
            { icon: "◎", text: "Dressings intégrés" },
            { icon: "◎", text: "Cloisons démontables" },
          ]}
        />
        <InteractiveImageCard
          title="Salles de Bains & d'Eau"
          description="Chaque logement dispose d'au moins une salle de bains ou salle d'eau avec WC séparé. Les grands logements en proposent deux."
          placeholderText="Salle de bains – rendu à venir"
          src={arch06.src}
          specs={[
            { icon: "◎", text: "SdB + SdE selon type" },
            { icon: "◎", text: "WC indépendant" },
            { icon: "◎", text: "Sèche-serviette" },
          ]}
        />
      </div>

      <!-- Row 4 -->
      <div class="lifestyle__row" data-animate="lifestyle-row-4">
        <InteractiveImageCard
          title="Local Vélos & Communs"
          description="Un local vélos sécurisé de 14,41 m² au rez-de-chaussée. Ascenseur 630 kg desservant tous les niveaux pour un quotidien facilité."
          placeholderText="Communs – rendu à venir"
          src={arch12.src}
          specs={[
            { icon: "◎", text: "Local vélos 14,41 m²" },
            { icon: "◎", text: "Ascenseur 630 kg" },
            { icon: "◎", text: "Passerelle d'accès" },
          ]}
        />
        <InteractiveImageCard
          title="La Maison T15 — 312 m²"
          description="Un bien d'exception : maison individuelle de 312,91 m² répartie sur 4 niveaux (sous-sol, RDC, R+1, R+2), avec loggia, terrasses, jardins et accès indépendant."
          placeholderText="Maison – rendu à venir"
          src={arch01.src}
          specs={[
            { icon: "◎", text: "312,91 m² sur 4 niveaux" },
            { icon: "◎", text: "Loggia + terrasses" },
            { icon: "◎", text: "Accès indépendant" },
          ]}
        />
      </div>
    </div>

    <!-- 4. ACTION CTA -->
    <div
      style="display: flex; justify-content: center;"
      data-animate="lifestyle-action"
    >
      <Button
        href="#"
        variant="primary"
        class="js-download-brochure btn--full-mobile"
      >
        Télécharger la plaquette
      </Button>
    </div>

    <!-- 5. CLOSING NOTE -->
    <aside class="lifestyle__note" data-animate="lifestyle-note">
      <p class="lifestyle__note-text">
        Les surfaces et dispositions sont issues des plans architecte Haour Architecture (janvier 2026).
        Les finitions détaillées seront précisées dans la notice descriptive officielle.
      </p>
    </aside>
  </div>
</section>

<style>
  @import "../../styles/lifestyle.css";
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector(".lifestyle");
    if (!section) return;

    const ease = "power2.out";

    // ========================================
    // 2. HEADER REVEAL
    // ========================================
    gsap.fromTo(
      '[data-animate="lifestyle-header"]',
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease,
        scrollTrigger: {
          trigger: '[data-animate="lifestyle-header"]',
          start: "top 80%",
          once: true,
        },
      },
    );

    // ========================================
    // 3. SCROLL-INTERACTIVE MARQUEE
    // ========================================
    gsap.to(".lifestyle__marquee-inner", {
      xPercent: -50,
      ease: "none",
      scrollTrigger: {
        trigger: ".lifestyle",
        start: "top bottom",
        end: "bottom top",
        scrub: 1.5, // Slightly loose for elegant secondary motion
      },
    });

    // ========================================
    // 4. RESPONSIVE SCALE ANIMATION
    // ========================================
    const rows = document.querySelectorAll(".lifestyle__row");

    ScrollTrigger.matchMedia({
      // Desktop: Animate entire row together
      "(min-width: 900px)": function () {
        rows.forEach((row) => {
          gsap.fromTo(
            row,
            { scale: 0.92, opacity: 1 },
            {
              scale: 1,
              opacity: 1,
              ease: "none",
              scrollTrigger: {
                trigger: row,
                start: "top 92%",
                end: "top 60%",
                scrub: 1,
              },
            },
          );
        });
      },

      // Mobile: Animate each card individually
      "(max-width: 899px)": function () {
        rows.forEach((row) => {
          const cards = row.querySelectorAll(".interactive-card");
          cards.forEach((card) => {
            // 1. Scale Animation (Visual entry)
            gsap.fromTo(
              card,
              { scale: 0.92, opacity: 1 },
              {
                scale: 1,
                opacity: 1,
                ease: "none",
                scrollTrigger: {
                  trigger: card,
                  start: "top 85%",
                  end: "top 55%",
                  scrub: 1,
                },
              },
            );

            // 2. Active Toggle (Interaction imitation)
            ScrollTrigger.create({
              trigger: card,
              start: "top 20%", // Trigger around center (slightly lower to ensure it activates when dominant)
              end: "bottom top",
              toggleClass: "is-active",
            });
          });
        });
      },
    });

    // Parallax (Shared logic, safe to keep outside or duplicated if needed)
    rows.forEach((row) => {
      const images = row.querySelectorAll(".interactive-card__img");
      images.forEach((img) => {
        gsap.to(img, {
          y: "15%",
          ease: "none",
          scrollTrigger: {
            trigger: row,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        });
      });
    });

    // ========================================
    // 5. CLOSING NOTE
    // ========================================
    gsap.fromTo(
      '[data-animate="lifestyle-note"]',
      { opacity: 0 },
      {
        opacity: 1,
        duration: 1,
        ease,
        scrollTrigger: {
          trigger: '[data-animate="lifestyle-note"]',
          start: "top 85%",
          once: true,
        },
      },
    );

    gsap.fromTo(
      '[data-animate="lifestyle-action"]',
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease,
        scrollTrigger: {
          trigger: '[data-animate="lifestyle-action"]',
          start: "top 85%",
          once: true,
        },
      },
    );
  });
</script>
