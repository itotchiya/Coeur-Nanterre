---
/**
 * Cookie Consent Banner
 * GDPR-compliant cookie banner with accept / reject-analytics options
 */
---

<div class="cookie-banner" id="cookie-banner" role="dialog" aria-label="Gestion des cookies" aria-live="polite" hidden>
  <div class="cookie-banner__container">
    <div class="cookie-banner__content">
      <p class="cookie-banner__text type-body-sm">
        Nous utilisons des cookies techniques nécessaires au bon fonctionnement du site (sécurité reCAPTCHA) et, avec votre accord, des cookies de mesure d'audience pour comprendre comment le site est utilisé.
        <a href="/politique-confidentialite" class="cookie-banner__link">En savoir plus</a>
      </p>
    </div>
    <div class="cookie-banner__actions">
      <button class="cookie-banner__btn cookie-banner__btn--secondary" id="cookie-reject" type="button">
        Refuser les analytiques
      </button>
      <button class="cookie-banner__btn cookie-banner__btn--primary" id="cookie-accept" type="button">
        Tout accepter
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: var(--color-white);
    border-top: 1px solid var(--color-gray-200);
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.08);
    transform: translateY(100%);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cookie-banner.is-visible {
    transform: translateY(0);
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .cookie-banner__content {
    flex: 1;
    min-width: 0;
  }

  .cookie-banner__text {
    margin: 0;
    color: var(--color-gray-700);
    line-height: 1.5;
    font-size: 0.875rem;
  }

  .cookie-banner__link {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    white-space: nowrap;
  }

  .cookie-banner__link:hover {
    color: var(--color-primary-dark);
  }

  .cookie-banner__actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cookie-banner__btn {
    font-family: var(--font-family-base);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.625rem 1.25rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .cookie-banner__btn:hover {
    transform: translateY(-1px);
  }

  .cookie-banner__btn--primary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .cookie-banner__btn--primary:hover {
    background: var(--color-primary-dark);
  }

  .cookie-banner__btn--secondary {
    background: var(--color-gray-100);
    color: var(--color-gray-700);
    border: 1px solid var(--color-gray-200);
  }

  .cookie-banner__btn--secondary:hover {
    background: var(--color-gray-200);
  }

  @media (max-width: 768px) {
    .cookie-banner__container {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }

    .cookie-banner__actions {
      justify-content: stretch;
    }

    .cookie-banner__btn {
      flex: 1;
      text-align: center;
    }
  }
</style>

<script>
  (function () {
    const CONSENT_KEY = "cookie_consent";
    const banner = document.getElementById("cookie-banner");
    const btnAccept = document.getElementById("cookie-accept");
    const btnReject = document.getElementById("cookie-reject");

    if (!banner) return;

    // Check existing consent
    const existing = localStorage.getItem(CONSENT_KEY);
    if (existing) {
      applyConsent(existing);
      return;
    }

    // Show banner
    banner.hidden = false;
    // Trigger reflow for transition
    requestAnimationFrame(() => {
      banner.classList.add("is-visible");
    });

    function applyConsent(choice: string) {
      banner.classList.remove("is-visible");
      setTimeout(() => {
        banner.hidden = true;
      }, 500);

      localStorage.setItem(CONSENT_KEY, choice);

      // Dispatch custom event for other scripts (e.g. GA)
      window.dispatchEvent(new CustomEvent("cookie:consent", { detail: choice }));

      // If analytics accepted, you could load GA here:
      // if (choice === "all") { /* load Google Analytics */ }
    }

    btnAccept?.addEventListener("click", () => applyConsent("all"));
    btnReject?.addEventListener("click", () => applyConsent("essential"));
  })();
</script>
