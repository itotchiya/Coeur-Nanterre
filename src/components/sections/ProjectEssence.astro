---
/**
 * Project Essence Section
 * L'essence de Coeur Nanterre
 */
import AnimatedVerticalLine from "../ui/AnimatedVerticalLine.astro";

import { getImage } from "astro:assets";
import bgRaw from "../../assets/greeny-nanterre.avif";

const bgOpt = await getImage({
  src: bgRaw,
  format: "webp",
  quality: 80,
  width: 1920,
});
const bgImage = bgOpt.src;
---

<section
  class="project-essence"
  data-section="projet"
  id="projet"
  aria-labelledby="project-title"
>
  <div
    class="project-essence__bg"
    style={`background-image: url('${bgImage}');`}
  >
  </div>
  <div class="project-essence__overlay"></div>

  <header class="project-essence__header">
    <div class="project-essence__title-group">
      <AnimatedVerticalLine theme="dark" />
      <h2
        id="project-title"
        class="project-essence__title type-h2"
        data-animate="fade-up"
      >
        Ce qui rend ce projet different
      </h2>
    </div>
  </header>

  <div class="project-essence__content" data-animate="fade-up">
    <p class="project-essence__paragraph type-lead">
      Coeur Nanterre, c'est 8 logements - une maison ancienne rehabilitee et un
      batiment neuf, construits cote a cote avec les memes materiaux, le meme
      soin.
    </p>

    <p class="project-essence__paragraph type-body">
      On a volontairement garde le projet petit. Huit logements, pas plus.
      Assez pour que chacun se sente vraiment chez soi, pas dans une residence
      anonyme. L'idee etait simple, ne pas effacer ce qui existait, mais le
      faire coexister avec du neuf, ancien et contemporain, sans rupture.
    </p>

    <div class="project-principles">
      <ul class="project-principles__list">
        <li class="project-principles__item">
          <span class="project-principles__keyword">Rehabilitation</span>
          <span class="project-principles__description">
            Garder l'ame de la maison d'origine
          </span>
        </li>

        <li class="project-principles__item">
          <span class="project-principles__keyword">Contemporain</span>
          <span class="project-principles__description">
            Du neuf qui s'integre sans crier
          </span>
        </li>

        <li class="project-principles__item">
          <span class="project-principles__keyword">Echelle humaine</span>
          <span class="project-principles__description">
            Huit logements, une vraie tranquillite
          </span>
        </li>

        <li class="project-principles__item">
          <span class="project-principles__keyword">Dialogue urbain</span>
          <span class="project-principles__description">
            L'histoire du lieu, remise au present
          </span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  @import "../../styles/project-essence.css";
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector(".project-essence");
    const title = section?.querySelector(".project-essence__title");
    const paragraphs = section?.querySelectorAll(".project-essence__paragraph");

    if (section && title && paragraphs) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 75%",
          toggleActions: "play none none none",
        },
      });

      tl.fromTo(
        title,
        { y: 16, opacity: 0 },
        { y: 0, opacity: 1, duration: 1.0, ease: "power2.out" },
      );

      tl.fromTo(
        paragraphs,
        { y: 16, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 1.0,
          stagger: 0.3,
          ease: "power2.out",
        },
        "-=0.6",
      );

      const principles = section?.querySelectorAll(".project-principles__item");
      if (principles && principles.length > 0) {
        tl.fromTo(
          principles,
          { y: 10, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.8,
            stagger: 0.15,
            ease: "power2.out",
          },
          "-=0.4",
        );
      }

      const bgElement = section?.querySelector(".project-essence__bg");
      if (bgElement) {
        gsap.to(bgElement, {
          yPercent: 20,
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        });
      }
    }
  });
</script>
