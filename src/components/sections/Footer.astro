---
/**
 * Footer Component
 */
import { SALES_CONTACT } from "../../lib/site-config";
---

<footer class="footer" data-section="footer" id="contact">
  <div class="footer__container">
    <div class="footer__content" data-animate="footer-reveal">

      <!-- Top Section -->
      <div class="footer__main">

        <!-- Logo Column -->
        <div class="footer__branding">
          <img
            src="/Assets/logo-vertical.svg"
            alt="Cœur Nanterre"
            class="footer__logo"
          />
        </div>

        <!-- Sitemap Column -->
        <div class="footer__sitemap">
          <h4 class="footer__heading">Plan du site</h4>
          <nav class="footer__nav">
            <ul class="footer__nav-list">
              <li><a href="#projet" class="footer__nav-link">Projet</a></li>
              <li><a href="#adresse" class="footer__nav-link">Adresse</a></li>
              <li><a href="#connectivite" class="footer__nav-link">Atouts</a></li>
              <li><a href="#apartment" class="footer__nav-link">Appartements</a></li>
              <li><a href="#prestations" class="footer__nav-link">Prestations</a></li>
              <li><a href="#programme" class="footer__nav-link">Programme</a></li>
              <li><a href="#simulateur" class="footer__nav-link">Simulateur</a></li>
              <li><a href="#investisseur" class="footer__nav-link">Investisseurs</a></li>
            </ul>
          </nav>
        </div>

        <!-- Contact Column -->
        <div class="footer__contact">
          <h4 class="footer__heading">Contact</h4>
          <div class="footer__contact-links">
            <a href={`mailto:${SALES_CONTACT.email}`} class="footer__contact-row">
              <span class="footer__contact-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </span>
              <span class="footer__contact-text">{SALES_CONTACT.email}</span>
            </a>
            <a href={SALES_CONTACT.phoneHref} class="footer__contact-row">
              <span class="footer__contact-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </span>
              <span class="footer__contact-text footer__contact-text--phone">{SALES_CONTACT.phoneDisplay}</span>
            </a>
          </div>

          <div class="footer__social">
            <a
              href="https://www.instagram.com/coeurnanterre/"
              class="footer__social-link"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            <a
              href="https://www.facebook.com/coeurnanterre/"
              class="footer__social-link"
              aria-label="Facebook"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Commercialisation Column -->
        <div class="footer__commercialisation">
          <h4 class="footer__heading">Commercialisation</h4>
          <a
            href="https://neowimmo.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="footer__partner footer__partner--logo"
          >
            <img
              src="/Assets/logo-neo-vimo.svg"
              alt="Neo Vimo"
              class="footer__partner-logo footer__partner-logo--neo-vimo"
            />
          </a>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="footer__bottom">
        <p class="footer__copyright type-body-sm">
          © {new Date().getFullYear()} Cœur Nanterre — Tous droits réservés
        </p>
        <div class="footer__legal">
          <a href="/mentions-legales" class="footer__legal-link">Mentions légales</a>
          <a href="/politique-confidentialite" class="footer__legal-link">Politique de confidentialité</a>
        </div>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-white);
    padding: 5rem 2rem 2rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .footer__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    opacity: 0;
    transform: scale(0.97) translateY(16px);
  }

  .footer__main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer__main {
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
      gap: 3rem;
      align-items: start;
    }
  }

  .footer__heading {
    font-family: var(--font-family-base);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-400);
    margin: 0 0 1rem 0;
  }

  /* Branding */
  .footer__branding {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__logo {
    height: 120px;
    width: auto;
  }

  /* Sitemap */
  .footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__nav-link {
    font-family: var(--font-family-base);
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__nav-link:hover {
    color: var(--color-primary);
  }

  /* Contact */
  .footer__contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer__contact-row {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    font-family: var(--font-family-base);
    font-size: 0.9375rem;
    color: var(--color-gray-600);
  }

  .footer__contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-gray-100);
    color: var(--color-gray-600);
    flex-shrink: 0;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .footer__contact-row:hover .footer__contact-icon {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .footer__contact-text {
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-primary-dark);
    transition: color 0.2s ease;
  }

  .footer__contact-row:hover .footer__contact-text {
    color: var(--color-primary);
  }

  /* Commercialisation */
  .footer__commercialisation {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__partner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer__partner-name {
    font-family: var(--font-family-base);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    letter-spacing: 0.02em;
  }

  .footer__partner-tagline {
    font-family: var(--font-family-base);
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    font-style: italic;
  }

  .footer__partner-logo {
    height: 72px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    object-position: left center;
  }

  .footer__partner-logo--neo-vimo {
    height: 88px;
    max-width: 240px;
  }

  .footer__partner--logo {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .footer__partner--logo:hover {
    transform: scale(1.03);
  }

  /* Social */
  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-gray-100);
    color: var(--color-gray-600);
    transition: background 0.3s ease, color 0.3s ease;
  }

  .footer__social-link:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }

  /* Bottom Bar */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-gray-200);
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer__copyright {
    margin: 0;
    color: var(--color-gray-400);
  }

  .footer__legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer__legal-link {
    font-family: var(--font-family-base);
    font-size: 0.8125rem;
    color: var(--color-gray-400);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__legal-link:hover {
    color: var(--color-primary);
  }

  /* Mobile */
  @media (max-width: 767px) {
    .footer {
      padding: 3rem 1.5rem 2rem;
    }

    .footer__branding {
      align-items: center;
    }

    .footer__logo {
      height: 80px;
    }

    .footer__sitemap,
    .footer__contact,
    .footer__commercialisation {
      text-align: center;
    }

    .footer__heading {
      text-align: center;
    }

    .footer__nav-list {
      align-items: center;
    }

    .footer__contact-links {
      align-items: center;
    }

    .footer__social {
      justify-content: center;
      margin-top: 1rem;
    }

    .footer__partner {
      align-items: center;
    }

    .footer__partner-logo {
      object-position: center;
    }

    .footer__bottom {
      align-items: center;
      text-align: center;
    }

    .footer__legal {
      justify-content: center;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const footerContent = document.querySelector(".footer__content");
    const footerLinks = document.querySelectorAll('.footer__nav-link[href^="#"]');

    if (footerContent) {
      gsap.to(footerContent, {
        opacity: 1,
        scale: 1,
        y: 0,
        duration: 0.9,
        ease: "power2.out",
        scrollTrigger: {
          trigger: ".footer",
          start: "top 90%",
          toggleActions: "play none none none",
        },
      });
    }

    footerLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector(href);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  });
</script>
